{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          },
          "target": "es2022",
          "loose": true,
          "keepClassNames": true
        },
        "module": {
          "type": "commonjs",
          "importInterop": "none"
        }
      }
    ]
  },
  "testTimeout": 60000,
  "setupFiles": ["<rootDir>/../jest.swc-setup.js"],
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"]
}
